<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Add your custom appender configurations here if needed -->

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <filter class="xin.altitude.cms.common.support.SensitiveDataFilter"/>
    </appender>

    <!-- You can add more appenders here if needed -->

    <root level="debug">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>
