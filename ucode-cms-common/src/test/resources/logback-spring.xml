<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">

    <!-- Add your custom appender configurations here if needed -->
    <conversionRule conversionWord="maskedMsg" converterClass="xin.altitude.cms.common.support.log.SensitiveDataConverter"/>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %maskedMsg%n</pattern>
        </encoder>
    </appender>

    <!-- You can add more appenders here if needed -->

    <root level="debug">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>
